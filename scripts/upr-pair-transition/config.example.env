# Example config for coordinated UPR+host pair transition.
# Copy to a private operator path (NOT committed with production secrets).
# Fill WORKER_* and ACTIVATE_*/DEACTIVATE_* literals before any real cutover.
#
# This file never enables invitation emails or populates allowlists.
#
# Staging/placement ≠ WordPress activation. Host Requires Plugins: universal-product-reviews.
# Forward activation order: UPR then host. Rollback deactivation: host then UPR.

PAIR_MODE=disposable

PAIR_ROOT=/tmp/m3-pair-rehearsal
PLUGINS_LINK_ROOT=/tmp/m3-pair-rehearsal/plugins

# Defaults are upr-host-adapter / 0.1.1. Superseded biopentra-upr-host / 0.1.5 is refused.
HOST_SLUG=upr-host-adapter
HOST_VERSION=0.1.1
UPR_SLUG=universal-product-reviews
UPR_VERSION=0.3.0

# previous = restore prior tree; absent = first-install rollback (remove live links).
PAIR_PREVIOUS_MODE=previous

# Mandatory worker control — must be non-empty real commands for production.
WORKER_SUSPEND_CMD='false # REPLACE'
WORKER_RESUME_CMD='false # REPLACE'
WORKER_PROOF_CMD='false # REPLACE'

PREFLIGHT_CMD='false # REPLACE'
POST_VERIFY_CMD='false # REPLACE'
ROLLBACK_VERIFY_CMD='false # REPLACE'
CONFIRM_EMAILS_DISABLED_CMD='false # REPLACE'

# WordPress activation / deactivation (not filesystem placement).
# Production shapes (examples — lock before execute):
#   ACTIVATE_UPR_CMD='./wp plugin activate universal-product-reviews'
#   ACTIVATE_HOST_CMD='./wp plugin activate upr-host-adapter'
#   DEACTIVATE_HOST_CMD='./wp plugin deactivate upr-host-adapter --uninstall=0'
#   DEACTIVATE_UPR_CMD='./wp plugin deactivate universal-product-reviews --uninstall=0'
ACTIVATE_UPR_CMD='false # REPLACE'
ACTIVATE_HOST_CMD='false # REPLACE'
DEACTIVATE_HOST_CMD='false # REPLACE'
DEACTIVATE_UPR_CMD='false # REPLACE'

# Optional:
# MAINTENANCE_ON_CMD='./wp maintenance-mode activate'
# MAINTENANCE_OFF_CMD='./wp maintenance-mode deactivate'

# ---------------------------------------------------------------------------
# Production draft literals (read-only inventory 2026-08-27). NOT rehearsed on
# production. Operator must lock before execute.
#
# Compose root: /home/magpern/woocommerce
# AS/WP-Cron runner: compose service `cron` (curls wp-cron.php every 60s)
# User crontab: backups only
# biopentra-mail-worker: support IMAP (not UPR invitation send) — omit unless
# later proof shows invitation egress via that worker.
#
# WORKER_SUSPEND_CMD='cd /home/magpern/woocommerce && docker compose stop cron'
# WORKER_RESUME_CMD='cd /home/magpern/woocommerce && docker compose start cron'
# WORKER_PROOF_CMD: ./wp eval counting upr send hooks → upr_send_active=0
#
# Forward: place both trees → activate UPR → activate host → verify → resume.
# Rollback-to-absent: deactivate host → deactivate UPR → remove pointers → resume.
# ---------------------------------------------------------------------------
